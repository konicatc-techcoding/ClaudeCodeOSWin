<dict>
    <key>Label</key>
    <string>com.zackchiu.claudecodeos.hermes-telegram</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zackchiu/dev/ClaudeCodeOS/.venv/bin/python3</string>
        <string>/Users/zackchiu/dev/ClaudeCodeOS/hermes/adapters/telegram.py</string>
