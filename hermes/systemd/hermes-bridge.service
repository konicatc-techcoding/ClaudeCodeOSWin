# hermes/systemd/hermes-bridge.service — WSL2 等效版本（取代 hermes-bridge.plist）
# 一次性執行單元，觸發時機交給搭配的 hermes-bridge.timer
# （對應原本 plist 的 StartCalendarInterval Hour=8 Minute=10）。

[Unit]
Description=Hermes bridge (skill-sync) (one-shot, triggered by hermes-bridge.timer)

[Service]
Type=oneshot
WorkingDirectory=%h/dev/ClaudeCodeOSWin
ExecStart=%h/dev/ClaudeCodeOSWin/.venv/bin/python3 %h/dev/ClaudeCodeOSWin/hermes/adapters/hermes_bridge.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

StandardOutput=append:%h/dev/ClaudeCodeOSWin/logs/hermes/hermes_bridge_launchd.stdout.log
StandardError=append:%h/dev/ClaudeCodeOSWin/logs/hermes/hermes_bridge_launchd.stderr.log
